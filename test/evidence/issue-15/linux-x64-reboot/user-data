#cloud-config
users:
  - name: nooptest
    shell: /bin/bash
    lock_passwd: true
write_files:
  - path: /root/noop-provision
    permissions: '0700'
    content: |
      #!/bin/bash
      TASK_TTY=/dev/ttyS0; if [ "$(uname -m)" = aarch64 ]; then TASK_TTY=/dev/ttyAMA0; fi
      exec > /var/log/noop-provision.log 2>&1
      set -euxo pipefail
      trap 'TASK_RC=$?; echo "NOOP_VM_PROVISION_FAILED line=$LINENO status=$TASK_RC" > "$TASK_TTY"; tail -100 /var/log/noop-provision.log > "$TASK_TTY"; journalctl --no-pager -n 150 > "$TASK_TTY"; exit "$TASK_RC"' ERR
      mkdir -p /mnt/noop-assets
      mount -L NOOPASSETS /mnt/noop-assets
      cp -a /mnt/noop-assets/repo /opt/noop
      cp /mnt/noop-assets/bin/bun /mnt/noop-assets/bin/workerd /usr/local/bin/
      chmod 755 /usr/local/bin/bun /usr/local/bin/workerd
      install -d -o nooptest -g nooptest -m 700 /home/nooptest/.noop
      printf '[server]\ntoken = "synthetic-reboot-vm-machine-token-000"\n' > /home/nooptest/.noop/noop.toml
      chown nooptest:nooptest /home/nooptest/.noop/noop.toml
      chmod 600 /home/nooptest/.noop/noop.toml
      loginctl enable-linger nooptest
      TASK_UID=$(id -u nooptest)
      for n in $(seq 1 100); do [ -S "/run/user/$TASK_UID/bus" ] && break; sleep .2; done
      runuser -u nooptest -- env NOOP_HOME=/home/nooptest/.noop HUB_NO_MEDIC=1 PATH=/usr/local/bin:/usr/bin:/bin XDG_RUNTIME_DIR=/run/user/$TASK_UID DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$TASK_UID/bus /usr/local/bin/bun /opt/noop/src/cli.ts cloud service install --listen 0.0.0.0:8790
      systemctl enable --now noop-vm-proof.service
      if timeout 3 bash -c 'echo >/dev/tcp/1.1.1.1/443' 2>/dev/null; then echo NOOP_VM_PUBLIC_NETWORK_UNEXPECTED > "$TASK_TTY"; exit 1; else echo NOOP_VM_PUBLIC_NETWORK_BLOCKED > "$TASK_TTY"; fi
      echo NOOP_VM_PROVISIONED > "$TASK_TTY"
  - path: /usr/local/bin/noop-vm-proof
    permissions: '0755'
    content: |
      #!/bin/bash
      TASK_TTY=/dev/ttyS0; if [ "$(uname -m)" = aarch64 ]; then TASK_TTY=/dev/ttyAMA0; fi
      for n in $(seq 1 100); do loginctl show-user nooptest >/dev/null 2>&1 && break; sleep .2; done
      printf 'NOOP_VM_BOOT %s\n' "$(cat /proc/sys/kernel/random/boot_id)" > "$TASK_TTY"
      loginctl show-user nooptest -p Linger -p Sessions > "$TASK_TTY"
      TASK_UID=$(id -u nooptest)
      for n in $(seq 1 100); do [ -S "/run/user/$TASK_UID/bus" ] && break; sleep .2; done
      sleep 5
      runuser -u nooptest -- env XDG_RUNTIME_DIR=/run/user/$TASK_UID DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$TASK_UID/bus systemctl --user status noop-coordinator.service --no-pager > "$TASK_TTY" 2>&1 || true
      journalctl --user-unit=noop-coordinator.service --no-pager -n 40 > "$TASK_TTY" 2>&1 || true
      ss -ltnp > "$TASK_TTY" 2>&1 || true
  - path: /etc/systemd/system/noop-vm-proof.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Record Noop VM login state
      After=systemd-logind.service
      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/noop-vm-proof
      [Install]
      WantedBy=multi-user.target
runcmd:
  - [ /root/noop-provision ]
